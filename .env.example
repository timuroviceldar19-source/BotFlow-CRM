# ── Telegram Bot ──
BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
BOT_USERNAME=botflow_crm_bot
# Use "disabled" for the local portfolio demo without a real Telegram token.
# Use "polling" after adding a valid BOT_TOKEN.
BOT_MODE=disabled

# ── PostgreSQL ──
POSTGRES_DB=botflow_crm
POSTGRES_USER=botflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Backend API ──
# Local demo default. Docker Compose overrides DATABASE_URL inside containers.
DATABASE_URL=sqlite+aiosqlite:///./runtime.sqlite3
ADMIN_API_KEY=CHANGE_ME_RANDOM_32_CHARS
APP_BASE_URL=http://127.0.0.1:8000
WEB_BASE_URL=http://127.0.0.1:3000

# ── Partner / Acquisition ──
PARTNER_DEFAULT_URL=https://example.com/register?promo=YOURCODE
PARTNER_TRACKING_PARAM=click_id
PARTNER_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ── Public URL (for Nginx/SSL) ──
PUBLIC_URL=https://yourdomain.com
DOMAIN=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# ── Frontend (Next.js) ──
# Local dev default. Docker Compose overrides this with http://bot-api:8000.
API_BASE_URL=http://127.0.0.1:8000
